  "conflicts_between_sources": [
    {
      "topic": "anvil",
      "detail": "The wiki summary row says 0-2 and only a damage value. Forge 1.7.10 RotationHelper uses mask 0x1 for anvil orientation, and minecraft-data 1.8 lists orientation values 3 to 14 together with damage. So the wiki summary row omits the orientation bits."
    },
    {
      "topic": "torch",
      "detail": "The wiki table starts torch values at 1 (0 unused), and Forge uses 6 - meta for the direction. minecraft-data 1.8 labels 0 to 4 for the same states, one lower than the wiki. minecraft-data is off by one against the other two (assuming the usual ForgeDirection ordinal order, which was not read)."
    },
    {
      "topic": "dataset_labelled_1.7",
      "detail": "minecraft-data data/pc/1.7 contains stone variants, coarse dirt and prismarine (id 168), which belong to later versions."
    }
